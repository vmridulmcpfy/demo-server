{
  "name": "demo-server",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "An MCP server with a React widget, built with mcpfy.",
  "scripts": {
    "dev": "mcpfy dev -- --http --port 3000",
    "dev:stdio": "mcpfy dev -- --stdio",
    "dev:http": "mcpfy dev -- --http --port 3000",
    "build": "mcpfy build && tsc",
    "start": "node --env-file-if-exists=.env dist/server.js"
  },
  "dependencies": {
    "mcpfy-sdk": "^0.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@tailwindcss/vite": "^4.1.11",
    "tailwindcss": "^4.1.11"
  }
}
